
import java.math.BigInteger;
import java.util.Scanner;
public class DiffieHellman {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter prime number (p): ");
        BigInteger p = sc.nextBigInteger();

        System.out.print("Enter primitive root (g): ");
        BigInteger g = sc.nextBigInteger();

        System.out.print("Enter Alice's private key: ");
        BigInteger a = sc.nextBigInteger();

        System.out.print("Enter Bob's private key: ");
        BigInteger b = sc.nextBigInteger();

        BigInteger A = g.modPow(a, p);
        BigInteger B = g.modPow(b, p);

        BigInteger keyAlice = B.modPow(a, p);
        BigInteger keyBob = A.modPow(b, p);

        System.out.println("\nAlice's public key: " + A);
        System.out.println("Bob's public key: " + B);

        System.out.println("Alice's shared key: " + keyAlice);
        System.out.println("Bob's shared key: " + keyBob);

        if (keyAlice.equals(keyBob)) {
            System.out.println("Shared key successfully established!");
        } else {
            System.out.println("Key exchange failed.");
        }

        sc.close();
    }
}
